generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String
  refreshToken String?

  projects       Project[]
  collaborations Collaboration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String  @id @default(uuid())
  name       String
  ownerId     String

  owner          User            @relation(fields: [ownerId], references: [id])
  collaborations Collaboration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fsnodes   FSNode[]
}

model FSNode {
  id   String  @id @default(uuid())
  name String
  type FSNType

  parentId String?
  parent   FSNode?  @relation("FSNodeToParent", fields: [parentId], references: [id], onDelete: Cascade)
  children FSNode[] @relation("FSNodeToParent")

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  snapshots Snapshot[]

  @@unique([projectId, parentId, name])
}

model Snapshot {
  id       String @id @default(uuid())
  fsnodeId String
  data     Bytes?

  fsnode FSNode @relation(fields: [fsnodeId], references: [id])

  createdAt DateTime @default(now())

  @@index([fsnodeId, createdAt])
}

model Collaboration {
  id        String @id @default(uuid())
  userId    String
  projectId String
  role      Role   @default(VIEWER)

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
}

enum Role {
  VIEWER
  EDITOR
  OWNER
}

enum FSNType {
  FILE
  FOLDER
}
